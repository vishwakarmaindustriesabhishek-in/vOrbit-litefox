diff --git a/browser/themes/shared/tabbrowser/tabs.css b/browser/themes/shared/tabbrowser/tabs.css
--- a/browser/themes/shared/tabbrowser/tabs.css
+++ b/browser/themes/shared/tabbrowser/tabs.css
@@ -1054,6 +1054,16 @@
     outline-color: transparent;
     box-shadow: inset 0 2px color-mix(in srgb, #299cba 53%, var(--toolbar-bgcolor));
   }
+
+  :where(
+    #tabbrowser-tabs[orient="vertical"]:not([movingtab])
+    .tabbrowser-tab:not(tab-group *, tab-split-view-wrapper *) > .tab-stack
+  ) > .tab-background[selected]:not([multiselected]) {
+    box-sizing: border-box;
+    border-inline-start: 2px solid color-mix(in srgb, #299cba 62%, var(--tab-selected-bgcolor));
+    outline-color: color-mix(in srgb, currentColor 16%, transparent);
+    box-shadow: none;
+  }
 }
 
