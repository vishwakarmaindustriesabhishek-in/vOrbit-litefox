+  applyVOrbitToolbarLayout() {
+    const placements = gSavedState?.placements;
+    const toolbar = placements?.[CustomizableUI.AREA_NAVBAR];
+    if (!toolbar) {
+      return false;
+    }
+
+    const isPlaced = id =>
+      Object.values(placements).some(area => area.includes(id));
+    let changed = false;
+    const urlbar = toolbar.indexOf("urlbar-container");
+    if (urlbar >= 0) {
+      const before = toolbar[urlbar - 1] === "vertical-spacer" ? urlbar - 2 : urlbar - 1;
