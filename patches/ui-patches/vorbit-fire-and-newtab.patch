+    const home = toolbar.indexOf("home-button");
+    if (reload >= 0 && home === reload + 1) {
+      toolbar.splice(home, 1);
+      toolbar.splice(reload, 0, "home-button");
+      changed = true;
+    } else if (!isPlaced("home-button")) {
+      const urlbar = toolbar.indexOf("urlbar-container");
+      const position = reload >= 0 ? reload : Math.max(0, urlbar);
+      toolbar.splice(position, 0, "home-button");
+      changed = true;
+    }
+
+    if (gPalette.has("panic-button") && !isPlaced("panic-button")) {
+      const downloads = toolbar.indexOf("downloads-button");
+      const position = downloads >= 0 ? downloads : toolbar.length;
+      toolbar.splice(position, 0, "panic-button");
+      changed = true;
+    }
+    return changed;
