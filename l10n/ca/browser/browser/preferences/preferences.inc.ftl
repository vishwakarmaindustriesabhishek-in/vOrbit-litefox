pane-vorbit-title = vOrbit-lite
category-vorbit =
    .tooltiptext = about:config canvis, lògicament agrupat i fàcilment accessible
vorbit-header = Preferències
vorbit-warning-title = Atenció!
vorbit-warning-description = Nosaltres triem acuradament la configuració predeterminada per centrar-nos en la privadesa i la seguretat. Quan canvieu aquesta configuració, llegiu les descripcions per entendre les implicacions d'aquests canvis.
vorbit-general-heading = Conducta del navegador
vorbit-extension-update-checkbox =
    .label = Actualitza els complements automáticament
vorbit-sync-checkbox =
    .label = Habilita la sincronització de Firefox
vorbit-autocopy-checkbox =
    .label = Activa enganxa amb el clic central
vorbit-styling-checkbox =
    .label = Permet la customització userChrome.css
vorbit-network-heading = Xarxes
vorbit-ipv6-checkbox =
    .label = Activa IPv6
vorbit-privacy-heading = Privacitat
vorbit-xorigin-ref-checkbox =
    .label = Limita Les referéncies d'origen creuat
vorbit-broken-heading = Empremtes dactilars
vorbit-webgl-checkbox =
    .label = Activa WebGL amb permisos per página.
vorbit-rfp-checkbox =
    .label = Activa ResistFingerprinting
vorbit-letterboxing-checkbox =
    .label = Activa la impressió en bústia
vorbit-security-heading = Seguretat
vorbit-ocsp-checkbox =
    .label = Força l'errada d'OCSP
vorbit-goog-safe-checkbox =
    .label = Activa la Navegació Segura de Google
vorbit-goog-safe-download-checkbox =
    .label = Analitza les descárregues
vorbit-extension-update-description = Mantingueu les extensions actualitzades sense intervenció manual. Una bona opció per a la vostra seguretat.
vorbit-extension-update-warning1 = Si no reviseu el codi de les extensions abans de cada actualització, hauríeu d'activar aquesta opció.
vorbit-ipv6-description = Allow { -brand-short-name } per a connectar emprant IPv6.
vorbit-ipv6-warning1 = En comptes de bloquejar l'IPv6 al navegador, vos suggerim que activeu l'extensió de privadesa IPv6 al vostre sistema operatiu.
vorbit-ocsp-description = Impedir la connexió a un lloc web si no es pot realitzar la comprovació OCSP.
vorbit-ocsp-warning1 = Això augmenta la seguretat, però causarà fallades quan un servidor OCSP no funcioni.
vorbit-sync-description = Sincronitza les teues dades amb altres navegadors. Cal reiniciar.
vorbit-sync-warning1 = Firefox Sync xifra les dades localment abans de transmetre-les al servidor.
vorbit-autocopy-description = Seleccioneu text per copiar-lo i, a continuació, enganxeu-lo amb un clic amb el botó central del ratolí.
vorbit-styling-description = Activeu això si voleu personalitzar la interfície d'usuari amb un tema carregat manualment.
vorbit-styling-warning1 = Assegureu-vos de confiar en el proveïdor del tema.
vorbit-xorigin-ref-description = Envia un referent només al mateix origen.
vorbit-xorigin-ref-warning1 = Això pot causar trencaments. A més, fins i tot quan s'enviïn, els referents es retallaran.
vorbit-webgl-description = WebGL és un vector d'empremtes dactilars potent. Això activa WebGL amb una sol·licitud de permís per lloc.
vorbit-webgl-warning1 = Quan un lloc intenti crear un context WebGL, se us demanarà permís primer.
vorbit-rfp-description = ResistFingerprinting és la millor eina antiempremtes dactilars de la seva classe.
vorbit-rfp-warning1 = Si cal desactivar-ho, considereu la possibilitat d'utilitzar una extensió com ara Canvas Blocker.
vorbit-letterboxing-description = El letterboxing aplica marges al voltant de les finestres per retornar un conjunt limitat de resolucions arrodonides.
vorbit-goog-safe-description = Si vos preocupa el programari maliciós i el phishing, considereu activar-lo.
vorbit-goog-safe-warning1 = Desactivat per motius de censura, però recomanat per a usuaris menys avançats. Totes les comprovacions es fan localment.
vorbit-goog-safe-download-description = Permet que Navegació Segura escanegi les teues baixades per identificar fitxers sospitosos.
vorbit-goog-safe-download-warning1 = Totes les comprovacions es fan localment.
vorbit-footer = Enllaços útils
vorbit-config-link = Tots els paràmetres avançats (about:config)
vorbit-open-profile = Obre el directori del perfil d'usuari
content-blocking-section-top-level-description = vOrbit-lite admet (i habilita per defecte) la protecció de seguiment millorada en mode estricte. Aquesta és una de les configuracions més importants del navegador, ja que proporciona particions d'estat, llistes de bloqueig estrictes i altres funcions de privadesa útils. No recomanem canviar a altres modes.
vorbit-webgl-prompt-checkbox =
    .label = Amaga la finestra emergent lloc per lloc de WebGL
vorbit-webgl-prompt-description = Això amaga la finestra emergent que apareix quan un lloc intenta crear un context WebGL. Encara podeu mostrar manualment la sol·licitud fent clic a la icona de la barra de cerca.
permissions-webgl2 =
    .label = WebGL
