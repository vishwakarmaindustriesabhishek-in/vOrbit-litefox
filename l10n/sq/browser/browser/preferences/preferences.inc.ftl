vorbit-ocsp-checkbox =
    .label = Detyreo “hard-fail” OCSP
vorbit-goog-safe-checkbox =
    .label = Aktivizo “Google Safe Browsing”
vorbit-goog-safe-download-checkbox =
    .label = Skanoji shkarkimet
vorbit-extension-update-description = Mbajini të përditësuar zgjerimet, pa ndërhyrje dorazi. Një zgjedhje e mirë për sigurinë tuaj.
vorbit-extension-update-warning1 = Nëse nuk shqyrtoni kodin e zgjerimeve tuaja para çdo përditësimi, duhet ta aktivizoni këtë mundësi.
vorbit-ipv6-description = Lejoje { -brand-short-name }-in të lidhet duke përdorur IPv6.
vorbit-ipv6-warning1 = Në vend të bllokimit të IPv6-s te shfletuesi, sugjerojmë aktivizimin e zgjerimit për privatësi IPv6 në OS-in tuaj.
vorbit-ocsp-description = Pengo lidhjen te një sajt, nëse s’kryhet dot kontrolli OCSP.
vorbit-ocsp-warning1 = Kjo shton sigurinë, por do të sjellë ndërprerje funksionimi, kur një shërbyes OCSP është jashtë funksionimi.
vorbit-sync-description = Njëkohësoni të dhënat tuaja me ato të shfletuesve të tjerë. Lyp rinisje.
vorbit-sync-warning1 = Firefox Sync i fshehtëzon lokalisht të dhënat, para se t’i transmetojë te shërbyesi.
vorbit-autocopy-description = Përzgjidhni ca tekst që të kopjohet, mandej ngjiteni me një klikim të butoni të mesit të miut.
vorbit-styling-description = Aktivizojeni, nëse doni të përshtatni UI-n me një temë të ngarkuar dorazi.
vorbit-styling-warning1 = Sigurohuni se i zini besë furnizuesit të temës.
vorbit-xorigin-ref-description = Dërgo një referues vetëm për “same-origin”.
vorbit-xorigin-ref-warning1 = Kjo mund të shkaktojë prishje gjërash. Veç kësaj, edhe kur dërgohen, referuesit prapë do të qethen.
vorbit-webgl-description = Kjo aktivizon WebGL me një hap për leje sipas sajti specifik.
vorbit-rfp-description = ResistFingerprinting është mjeti anti-krijim-shenjash-gishtas më i miri në klasën e vet.
vorbit-rfp-warning1 = Nëse ju duhet ta çaktivizoni, shihni mundësinë e përdorimit të një zgjerimi si Canvas Blocker.
vorbit-letterboxing-description = “Letterboxing” aplikon mënjana rreth dritares tuaj, që të mund të përgjigjet me një grup të kufizuar zgjidhjesh të përafërta.
vorbit-goog-safe-description = Nëse shqetësoheni rreth malware-i dhe karremëzimesh, shihni mundësinë e aktivizimit të kësaj.
vorbit-goog-safe-warning1 = Çaktivizuar për shkak shqetësimesh lidhur me censurimin, për e rekomanduar për përdorues më pak të përparuar. Krejt kontrollet kryhen lokalisht.
vorbit-goog-safe-download-description = Lejojeni Shfletimin e Parrezik të kontrollojë shkarkimet tuaja, për të identifikuar kartela të dyshimta.
vorbit-goog-safe-download-warning1 = Krejt kontrollet bëhen lokalisht.
vorbit-footer = Lidhje të dobishme
vorbit-webgl-warning1 = Kur një sajt provon të krijojë një kontekst WebGL, së pari do t’ju kërkohet leje.
vorbit-config-link = Krejt rregullimet e mëtejshme (about:config)
vorbit-open-profile = Hap drejtori profilesh përdoruesi
content-blocking-section-top-level-description = vOrbit-lite-i mbulon - dhe e aktivizon si parazgjedhje - Mbrojtjen e Thelluar Nga Gjurmimi nën mënyrën Strikte. Kjo është një nga rregullimet më të rëndësishme te shfletuesi, ngaqë furnizon ndarje gjendjesh, lista bllokimesh strikte dhe të tjera veçori të goditura sigurie. Nuk rekomandojmë kalimin në mënyra të tjera.
pane-vorbit-title = vOrbit-lite
category-vorbit =
    .tooltiptext = ndryshime te about:config, të grupuara logjikisht dhe të përdorshme lehtësisht
vorbit-header = Parapëlqime vOrbit-lite-i
vorbit-warning-title = Hapni sytë!
vorbit-warning-description = Zgjedhim me kujdes rregullime parazgjedhje për t’u përqendruar te privatësia dhe siguria. Kur ndryshoni këto rregullime, lexoni përshkrimin që të kuptoni se ç’sjellin këto ndryshime.
